<Window x:Class="SurpriseConfettiShower.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surprise Confetti Shower"
        Icon="app.ico"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}"
        FontSize="{x:Static SystemFonts.MessageFontSize}">

    <Window.Resources>
        <!-- The IsEnabled trigger is what greys out the text inside a sub-panel that is not in use. -->
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9B9B9B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#6B6B6B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ValidationHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="#C42B1C"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,22,24,24">
            <TextBlock Style="{StaticResource SectionHeader}" Text="Effect"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ConfettiOption" GroupName="Effect" Content="Confetti" Margin="0,0,28,0"/>
                <RadioButton x:Name="FireworksOption" GroupName="Effect" Content="Fireworks"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="When" Margin="0,24,0,10"/>

            <RadioButton x:Name="SurpriseOption" GroupName="Mode" Content="Surprise me"/>
            <StackPanel Margin="26,10,0,0" IsEnabled="{Binding IsChecked, ElementName=SurpriseOption}">
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <ComboBox x:Name="PerDayBox" Width="54"/>
                        <TextBlock Text="times a day," Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="between"/>
                        <ComboBox x:Name="FromHourBox" Width="76" Margin="8,0,0,0"/>
                        <TextBlock Text="and" Margin="8,0,0,0"/>
                        <ComboBox x:Name="UntilHourBox" Width="76" Margin="8,0,0,0"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Text="Random times are rolled for the next two days, and rolled again every time you save."/>
            </StackPanel>

            <RadioButton x:Name="ScheduleOption" GroupName="Mode" Content="On a schedule" Margin="0,18,0,0"/>
            <StackPanel Margin="26,10,0,0" IsEnabled="{Binding IsChecked, ElementName=ScheduleOption}">
                <RadioButton x:Name="EveryHourOption" GroupName="Schedule" Content="Every full hour"/>
                <RadioButton x:Name="SpecificTimesOption" GroupName="Schedule" Content="At these times:" Margin="0,10,0,0"/>
                <TextBox x:Name="TimesBox" Margin="26,8,0,0" Padding="6,4"
                         IsEnabled="{Binding IsChecked, ElementName=SpecificTimesOption}"
                         TextChanged="OnTimesChanged"/>
                <TextBlock x:Name="TimesError" Style="{StaticResource ValidationHint}" Margin="26,6,0,0"
                           Visibility="Collapsed"
                           Text="Enter at least one time as HH:mm."/>
                <TextBlock Style="{StaticResource Hint}" Margin="26,6,0,0" Text="For example: 09:00, 12:30, 17:00"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Startup" Margin="0,24,0,10"/>
            <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#E4E4E4" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid>
                <Button Content="Test effect" HorizontalAlignment="Left" Click="OnTestEffect"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" IsDefault="True" Click="OnSave" Margin="0,0,10,0"/>
                    <Button Content="Cancel" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
